# Database configuration
DB_USER=lifelink
DB_PASSWORD=lifelink
DB_NAME=lifelink_db

# JWT Configuration (generate a strong random secret in production)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=86400000 # 24 hours

# Firebase Admin SDK credentials file path
FIREBASE_CONFIG_PATH=classpath:firebase-service-account.json

# Optional outbound SMS/WhatsApp through Twilio (disabled by default)
TWILIO_ENABLED=false
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=
# Set this to the exact public callback URL configured with Twilio.
TWILIO_PUBLIC_WEBHOOK_URL=
APP_BASE_URL=http://localhost:8080
INVENTORY_STALE_HOURS=24
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
